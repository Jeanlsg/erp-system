# =============================================================================
# ERP System — Environment Variables
# =============================================================================
# Copie este arquivo para .env e preencha os valores reais
# NÃO COMMITAR o arquivo .env (está no .gitignore)

# -----------------------------------------------------------------------------
# Supabase (Frontend - bundled com Vite)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
VITE_SITE_URL=https://seu-dominio.com
VITE_APP_NAME=ERP System

# -----------------------------------------------------------------------------
# Multi-Loja (opcional)
# -----------------------------------------------------------------------------
VITE_LOJA_DEFAULT_ID=loja-01

# -----------------------------------------------------------------------------
# Ferramentas locais das skills (.claude/skills) — deploy, testes, banco
# Sem prefixo VITE_: o Vite NÃO leva estas chaves para o bundle.
# As skills citam só o NOME da variável; o valor real vive no .env.
# -----------------------------------------------------------------------------
ERP_SSH_HOST=alias-ssh-da-vps            # entrada do ~/.ssh/config
ERP_URL=https://erp.seu-dominio.com.br
ERP_DEPLOY_WEBHOOK=http://IP:3000/api/deploy/TOKEN   # contém segredo
ERP_APP_SERVICE=apps_erp                 # serviço Swarm do front
ERP_APP_CODE_DIR=/etc/easypanel/projects/apps/erp/code
ERP_DB_CONTAINER=apps_supabase-db-1
ERP_REST_CONTAINER=apps_supabase-rest-1
ERP_FUNCTIONS_CONTAINER=apps_supabase-functions-1
ERP_FUNCTIONS_DIR=/etc/easypanel/projects/apps/supabase/code/supabase/code/volumes/functions
ERP_NFE_SERVICE_CONTAINER=nfe-service
ERP_NFE_SERVICE_DIR=/opt/nfe-service
ERP_DOCKER_NETWORK=apps_supabase_default
ERP_BACKUP_DIR=/opt/backups
ERP_LOJA_PETROLINA_ID=uuid-da-loja
ERP_LOJA_JUAZEIRO_ID=uuid-da-loja
ERP_ADMIN_EMAIL=admin@cliente.com
ERP_ADMIN_USER_ID=uuid-do-admin
# Conta de TESTE para E2E/tutoriais — criar, usar e desativar ao fim
ERP_TESTE_EMAIL=
ERP_TESTE_SENHA=
CRM_REPO_DIR=../crprod                   # checkout local do CRM (api-leads)
